# ZoneBoard settings for running on your own computer.
# start-zoneboard.bat copies this file to zoneboard.env the first time; edit zoneboard.env, not this one.
# Lines starting with # are notes. No spaces around the = sign.

# Market data: Upstox (free). From https://account.upstox.com/developer/apps, your app's
# API key and API secret. In that app, set the Redirect URL to exactly:  http://127.0.0.1:8080/callback
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# Or Zerodha Kite instead (needs the paid Connect plan). Used only when the Upstox lines are empty.
# Kite app Redirect URL: http://127.0.0.1:8080/callback
KITE_API_KEY=
KITE_API_SECRET=

# The password you type to open the board. Pick your own.
# Letters and numbers are safest. If it has a # in it, put it in double quotes: SITE_PASSWORD="abc#123"
# (everything after an unquoted # is ignored).
SITE_PASSWORD=

# Optional: one-line AI news summaries next to plans (console.anthropic.com). Leave empty for none.
ANTHROPIC_API_KEY=

# Optional: market flags that set a plan aside, e.g. late,against_index. Empty = flag only.
PLAN_FILTERS=

# Leave these as they are.
PORT=8080
BASE_URL=http://127.0.0.1:8080
OPEN_ACCESS=1
ADMIN_EMAIL=owner@zoneboard.local
SITE_NAME=ZoneBoard
